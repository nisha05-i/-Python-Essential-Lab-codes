import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 25, 30]

# 1. Line Plot
plt.figure()
plt.plot(x, y, marker='o')
plt.title("Line Plot")
plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.grid()
plt.show()

# 2. Scatter Plot
plt.figure()
plt.scatter(x, y, color='red')
plt.title("Scatter Plot")
plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.show()

# 3. Bar Chart
plt.figure()
plt.bar(x, y, color='green')
plt.title("Bar Chart")
plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.show()

# 4. Box Plot
plt.figure()
data = [10, 20, 15, 25, 30, 35, 40, 20, 25]
plt.boxplot(data)
plt.title("Box Plot")
plt.ylabel("Values")
plt.show()

# 5. Pie Chart
plt.figure()
labels = ['Python', 'Java', 'C++', 'JavaScript']
sizes = [40, 25, 20, 15]
plt.pie(sizes, labels=labels, autopct='%1.1f%%')
plt.title("Pie Chart")
plt.show()
